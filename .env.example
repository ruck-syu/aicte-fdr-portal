# Supabase project (Project Settings -> API). The Vercel <-> Supabase
# integration sets these automatically; legacy anon / service_role names work too.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Used to create users (admin) and by the daily alert job.
SUPABASE_SECRET_KEY=sb_secret_...

# Protects /api/cron/alerts. Vercel Cron sends it as a Bearer token automatically.
CRON_SECRET=generate-a-long-random-string

# Optional: email alerts through Resend (https://resend.com). Leave blank to
# keep alerts in-app only.
RESEND_API_KEY=
ALERT_FROM_EMAIL="AICTE FDR Portal <alerts@your-domain.in>"
# Public URL used for links in alert emails (defaults to the Vercel production URL).
APP_URL=

# Bank verification provider for "Verify with bank": mock (default, offline and
# deterministic) or http (requires BANK_VERIFIER_URL; adapter in src/lib/bank/).
BANK_VERIFIER=mock
BANK_VERIFIER_URL=

# Optional: SMS alerts for institutions that opt in under Admin -> Institutions.
# mock (default: offline, deterministic, no credentials) or msg91 (needs all
# three values below; adapter in src/lib/sms/).
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=

# Show the demo account hints on the sign-in page (never enable in production).
NEXT_PUBLIC_DEMO_MODE=false
